DATABASE_URL=sqlite:///./data/app.db
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=mistral:7b
# Receipt photos use on-server OCR + OLLAMA_TEXT_MODEL (no extra model required).
# Optional vision fallback if OCR fails (ollama pull llava:7b):
# OLLAMA_VISION_MODEL=llava:7b
# RECEIPT_VISION_FALLBACK=true
# When true, POST /recipes/generate saves each recipe unless the client sends persist_generated=false
DEFAULT_PERSIST_GENERATED_RECIPES=false
# Publix store number for POST /recipes/generate/publix-bogo (find yours at publix.com/locations)
# PUBLIX_STORE_NUMBER=1885
