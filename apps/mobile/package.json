{
  "name": "ai-recipe-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --go --host lan -c",
    "start:tunnel": "expo start --tunnel --go -c",
    "start:go": "expo start --go --host lan -c",
    "start:web": "expo start --web -c",
    "android": "expo start --android --host lan",
    "ios": "expo start --ios --host lan",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "fix-deps": "npx expo install --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
